# Get this from https://aistudio.google.com -> "Get API key".
# This single key powers Gemini calls AND Google Maps / Search grounding.
# Billing tier must be at least Tier 1 for Maps grounding.
GEMINI_API_KEY=your_ai_studio_api_key_here

# Optional override. Defaults to gemini-3.5-flash if unset.
GEMINI_MODEL=gemini-3.5-flash
