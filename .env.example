# Copy to .env in repo root (backend reads this via python-dotenv).

# Get this from https://aistudio.google.com -> "Get API key".
# Powers Gemini 3.5 Flash + Maps/Search grounding in one key.
GEMINI_API_KEY=your_ai_studio_api_key_here

# Default model (Gemini 3.5 Flash)
GEMINI_MODEL=gemini-3.5-flash

# --- Frontend (copy frontend/.env.local.example -> frontend/.env.local) ---
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_URL=http://localhost:8000
